{
  "name": "nova-api",
  "version": "1.0.0",
  "description": "A simple Express API that fetches and filters authenticated user details and decodes JWT tokens.",
  "license": "MIT",
  "author": "NDTP",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "bundle": "npm run copy-data && npx esbuild src/server.ts --platform=node --target=node20 --format=cjs --bundle --minify --sourcemap --outfile=dist/server.cjs",
    "copy-data": "cp -r src/data dist/src/data",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --collect-coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fuse.js": "7.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.25.5",
    "eslint": "^9.23.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  }
}
